# CognoDB / Neo4j connection — copy this file to `.env` and fill in real values.
# Get these from the CognoDB Cloud console (console.cognodb.com):
#   Connection URI : bolt+s://<instance-id>.databases.cognodb.cloud
#   Username       : cognodb
#   Password       : shown exactly once when the instance is created.

NEO4J_URI=bolt+s://YOUR_INSTANCE_ID.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=your-generated-password

# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173